{
  "id": "mini-games",
  "name": "Mini Games",
  "description": "A little arcade inside Agent Code — garden Snake, 3D Blackjack, classic Minesweeper, a typing test, and Blockfall.",
  "version": "0.10.0",
  "apiVersion": 2,
  "entry": "dist/runtime.js",
  "activationEvents": [
    "onView:mini-games.open",
    "onView:mini-games.blackjack",
    "onView:mini-games.snake",
    "onView:mini-games.minesweeper",
    "onView:mini-games.typing",
    "onView:mini-games.blockfall"
  ],
  "contributes": {
    "commands": [
      {
        "id": "mini-games.open",
        "title": "Play Mini Games",
        "keywords": [
          "game",
          "arcade",
          "play",
          "break",
          "cards",
          "blackjack"
        ]
      },
      {
        "id": "mini-games.snake",
        "title": "Play Snake",
        "keywords": [
          "snake",
          "game",
          "arcade",
          "classic"
        ]
      },
      {
        "id": "mini-games.blackjack",
        "title": "Play Blackjack",
        "keywords": [
          "blackjack",
          "21",
          "cards",
          "casino",
          "game"
        ]
      },
      {
        "id": "mini-games.minesweeper",
        "title": "Play Minesweeper",
        "keywords": [
          "minesweeper",
          "mines",
          "puzzle",
          "game",
          "classic",
          "windows"
        ]
      },
      {
        "id": "mini-games.typing",
        "title": "Play Typing Test",
        "keywords": [
          "typing",
          "typing test",
          "wpm",
          "words per minute",
          "keyboard",
          "speed",
          "practice",
          "monkeytype"
        ]
      },
      {
        "id": "mini-games.blockfall",
        "title": "Play Blockfall",
        "keywords": [
          "blockfall",
          "blocks",
          "falling blocks",
          "tetromino",
          "line clear",
          "puzzle",
          "game",
          "arcade"
        ]
      }
    ],
    "views": [
      {
        "id": "mini-games.open",
        "title": "Mini Games",
        "mount": "modal",
        "entry": "dist/view.js"
      },
      {
        "id": "mini-games.snake",
        "title": "Snake",
        "mount": "modal",
        "entry": "dist/view.js"
      },
      {
        "id": "mini-games.blackjack",
        "title": "Blackjack",
        "mount": "modal",
        "entry": "dist/view.js"
      },
      {
        "id": "mini-games.minesweeper",
        "title": "Minesweeper",
        "mount": "modal",
        "entry": "dist/view.js"
      },
      {
        "id": "mini-games.typing",
        "title": "Typing Test",
        "mount": "modal",
        "entry": "dist/view.js"
      },
      {
        "id": "mini-games.blockfall",
        "title": "Blockfall",
        "mount": "modal",
        "entry": "dist/view.js"
      }
    ]
  }
}
