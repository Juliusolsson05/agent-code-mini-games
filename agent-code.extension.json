{
  "id": "mini-games",
  "name": "Mini Games",
  "description": "A little arcade inside Agent Code — garden Snake, 3D Blackjack, and classic Minesweeper.",
  "version": "0.8.0",
  "apiVersion": 2,
  "entry": "dist/runtime.js",
  "activationEvents": [
    "onView:mini-games.open",
    "onView:mini-games.blackjack",
    "onView:mini-games.snake",
    "onView:mini-games.minesweeper"
  ],
  "contributes": {
    "commands": [
      {
        "id": "mini-games.open",
        "title": "Play Mini Games",
        "keywords": [
          "game",
          "arcade",
          "play",
          "break",
          "cards",
          "blackjack"
        ]
      },
      {
        "id": "mini-games.snake",
        "title": "Play Snake",
        "keywords": [
          "snake",
          "game",
          "arcade",
          "classic"
        ]
      },
      {
        "id": "mini-games.blackjack",
        "title": "Play Blackjack",
        "keywords": [
          "blackjack",
          "21",
          "cards",
          "casino",
          "game"
        ]
      },
      {
        "id": "mini-games.minesweeper",
        "title": "Play Minesweeper",
        "keywords": [
          "minesweeper",
          "mines",
          "puzzle",
          "game",
          "classic",
          "windows"
        ]
      }
    ],
    "views": [
      {
        "id": "mini-games.open",
        "title": "Mini Games",
        "mount": "modal",
        "entry": "dist/view.js"
      },
      {
        "id": "mini-games.snake",
        "title": "Snake",
        "mount": "modal",
        "entry": "dist/view.js"
      },
      {
        "id": "mini-games.blackjack",
        "title": "Blackjack",
        "mount": "modal",
        "entry": "dist/view.js"
      },
      {
        "id": "mini-games.minesweeper",
        "title": "Minesweeper",
        "mount": "modal",
        "entry": "dist/view.js"
      }
    ]
  }
}
