{
  "name": "agent-code-mini-games",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "A little arcade inside Agent Code — garden Snake, 3D Blackjack, classic Minesweeper, and a typing test.",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "dev": "vite build --watch",
    "dev:web": "vite --config vite.dev.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node dev/test.mjs",
    "test:extension": "NODE_ENV=production npm run build && node --test testing/extension-contract.test.mjs",
    "verify": "npm test && npm run test:extension",
    "test:browser": "node dev/browser-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "agent-code-extension-api": "git+https://github.com/Juliusolsson05/agent-code-extension-api.git#9c30b9199ccb692de19673baa936e20154578080",
    "esbuild": "^0.21.5",
    "playwright": "^1.63.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.19"
  },
  "engines": {
    "node": ">=22"
  }
}
